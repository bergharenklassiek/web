  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "sheet:push": "cd apps-script && clasp push --force",
    "sheet:deploy": "npm run sheet:push && cd apps-script && clasp update-deployment \"$npm_package_config_sheetDeploymentId\" --description \"$(git rev-parse --short HEAD)\""
  },
